{
  "name": "versionly-e2e-consumer",
  "version": "1.0.0",
  "private": true,
  "description": "Dedicated E2E consumer app for Versionly — Stripe, OpenAI, Twilio usage that Versionly should detect and auto-fix.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "versionly:setup": "tsx scripts/versionly-setup.ts",
    "versionly:scan": "tsx scripts/versionly-scan.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@wowsql/sma": "^0.1.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "openai": "^4.77.0",
    "stripe": "^17.5.0",
    "twilio": "^5.4.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
